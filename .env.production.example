RECOVERYOS_DOMAIN=recovery.example.com
DATABASE_URL=postgresql://user:password@host/recoveryos?sslmode=require
DATABASE_CONNECT_MAX_ATTEMPTS=10
DATABASE_CONNECT_RETRY_MS=2000
# Production Compose overrides this with its private redis service. Keep this
# value aligned for commands that load the environment outside Compose.
REDIS_URL=redis://redis:6379
NODE_ENV=production
PORT=3001
LOG_REQUESTS=true
ALLOWED_ORIGINS=https://recovery.example.com

# Keep financial execution disabled for the hosted demonstration.
SIMULATION_MODE=true
ENABLE_LIVE_DEMO=false
ENABLE_RAZORPAYX_TEST_DEMO=false
RAZORPAYX_TEST_DEMO_FUND_ACCOUNT_ID=
RAZORPAYX_TEST_DEMO_COOLDOWN_SECONDS=300
DEMO_RETRY_DELAY_SECONDS=5
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

AUTH_MODE=token
VIEWER_API_TOKEN=replace-with-at-least-32-random-characters
OPERATOR_API_TOKEN=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters

AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_THINKING_MODE=disabled
AI_TIMEOUT_MS=15000
