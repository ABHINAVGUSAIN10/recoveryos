RECOVERYOS_DOMAIN=recovery.example.com
DATABASE_URL=postgresql://user:password@host/recoveryos?sslmode=require
DATABASE_CONNECT_MAX_ATTEMPTS=10
DATABASE_CONNECT_RETRY_MS=2000
REDIS_URL=rediss://default:password@host:6379
NODE_ENV=production
PORT=3001
LOG_REQUESTS=true
ALLOWED_ORIGINS=https://recovery.example.com

# Keep financial execution disabled for the hosted demonstration.
SIMULATION_MODE=true
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

AUTH_MODE=token
VIEWER_API_TOKEN=replace-with-at-least-32-random-characters
OPERATOR_API_TOKEN=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters

AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_THINKING_MODE=disabled
AI_TIMEOUT_MS=15000
