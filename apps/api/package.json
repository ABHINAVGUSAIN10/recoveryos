{
  "name": "@recoveryos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @recoveryos/domain build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @recoveryos/domain build",
    "build": "nest build",
    "start:prod": "node dist/main",
    "pretest": "pnpm --filter @recoveryos/domain build",
    "test": "jest --runInBand",
    "prisma:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:validate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "prisma:push": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js db push --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "presimulate": "pnpm --filter @recoveryos/domain build",
    "simulate": "ts-node src/simulator.ts",
    "simulate:prod": "node dist/simulator.js",
    "preacceptance:webhook": "pnpm --filter @recoveryos/domain build",
    "acceptance:webhook": "ts-node src/webhook-acceptance.ts",
    "acceptance:webhook:prod": "node dist/webhook-acceptance.js",
    "razorpay:readiness": "ts-node src/razorpay-readiness.ts --read-only",
    "razorpay:readiness:prod": "node dist/razorpay-readiness.js --read-only",
    "razorpay:sandbox-exercise": "ts-node src/razorpay-sandbox-exercise.ts --create-funded-test-payout",
    "razorpay:sandbox-exercise:prod": "node dist/razorpay-sandbox-exercise.js --create-funded-test-payout",
    "preai:evaluate": "pnpm --filter @recoveryos/domain build",
    "ai:evaluate": "ts-node src/ai-evaluate.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "@recoveryos/domain": "workspace:*",
    "bullmq": "^5.34.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "openai": "^4.80.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
