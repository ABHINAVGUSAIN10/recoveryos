generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentStatus {
  RECEIVED
  ANALYZING
  POLICY_PENDING
  AUTO_RETRY
  APPROVAL_REQUIRED
  STOPPED
  NO_ACTION
  EXECUTING
  PROCESSING
  RECOVERED
  FAILED
  REVERSED
  ESCALATE
  EXECUTION_UNKNOWN
}

enum Decision {
  AUTO_RETRY
  APPROVAL_REQUIRED
  ESCALATE
  STOPPED
  NO_ACTION
}

enum ReviewStatus {
  OPEN
  APPROVED
  REJECTED
}

enum ReviewKind {
  RETRY_APPROVAL
  REMEDIATION
}

enum ExecutionOutcome {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum RevenueIncidentStatus {
  DETECTED
  ANALYZING
  POLICY_PENDING
  AUTO_ACTION
  APPROVAL_REQUIRED
  ESCALATED
  STOPPED
  RECOVERED
  EXPIRED
}

enum RevenueActionOutcome {
  PENDING
  SUCCEEDED
  FAILED
  BLOCKED
  UNKNOWN
}

model PayoutIncident {
  id                 String            @id @default(uuid())
  razorpayPayoutId   String            @unique
  status             IncidentStatus
  amountPaise        Int
  currency           String            @default("INR")
  currentReason      String?
  beneficiaryRef     String?
  attempts           Int               @default(0)
  duplicateSuspected Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  events             PayoutEvent[]
  analyses           AiAnalysis[]
  policyDecisions    PolicyDecision[]
  executions         ActionExecution[]
  reviewTasks        ReviewTask[]
  auditEvents        AuditEvent[]
  batchResults       BatchResult[]
}

model PayoutEvent {
  id               String          @id @default(uuid())
  externalEventId  String          @unique
  eventType        String
  payloadJson      Json
  receivedAt       DateTime        @default(now())
  payoutIncidentId String?
  payoutIncident   PayoutIncident? @relation(fields: [payoutIncidentId], references: [id])
}

model AiAnalysis {
  id            String         @id @default(uuid())
  incidentId    String
  incident      PayoutIncident @relation(fields: [incidentId], references: [id])
  modelRef      String
  promptVersion String
  outputJson    Json
  confidence    Float
  createdAt     DateTime       @default(now())
}

model PolicyDecision {
  id             String         @id @default(uuid())
  incidentId     String
  incident       PayoutIncident @relation(fields: [incidentId], references: [id])
  policyVersion  String
  proposedAction String
  finalDecision  Decision
  reasonsJson    Json
  createdAt      DateTime       @default(now())
}

model ActionExecution {
  id             String           @id @default(uuid())
  incidentId     String
  incident       PayoutIncident   @relation(fields: [incidentId], references: [id])
  actionType     String
  idempotencyKey String           @unique
  requestHash    String
  responseJson   Json?
  outcome        ExecutionOutcome @default(PENDING)
  scheduledFor   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ReviewTask {
  id         String         @id @default(uuid())
  incidentId String
  incident   PayoutIncident @relation(fields: [incidentId], references: [id])
  kind       ReviewKind     @default(RETRY_APPROVAL)
  severity   String
  status     ReviewStatus   @default(OPEN)
  decision   String?
  remediationJson Json?
  decidedAt  DateTime?
  actorId    String?
  createdAt  DateTime       @default(now())
}

model AuditEvent {
  id            String         @id @default(uuid())
  incidentId    String
  incident      PayoutIncident @relation(fields: [incidentId], references: [id])
  eventType     String
  actorType     String
  actorId       String?
  policyVersion String?
  decision      String?
  amountPaise   Int?
  rationale     String
  dataJson      Json
  createdAt     DateTime       @default(now())
}

model PolicyConfig {
  id          String   @id @default(uuid())
  version     String   @unique
  rulesJson   Json
  active      Boolean  @default(true)
  effectiveAt DateTime @default(now())
  createdBy   String
}

model BatchRun {
  id                    String        @id @default(uuid())
  name                  String
  cohortSize            Int
  totalValueAtRiskPaise Int           @default(0)
  policyVersion         String?
  modelRef              String?
  promptVersion         String?
  cohortFingerprint     String?
  baselineJson          Json?
  metricsJson           Json?
  startedAt             DateTime      @default(now())
  completedAt           DateTime?
  results               BatchResult[]
}

model BatchResult {
  id                  String         @id @default(uuid())
  batchRunId          String
  batchRun            BatchRun       @relation(fields: [batchRunId], references: [id])
  incidentId          String
  incident            PayoutIncident @relation(fields: [incidentId], references: [id])
  finalState          String
  recoveredValuePaise Int            @default(0)
  eligibleForRecovery Boolean         @default(false)
  humanInterventions  Int             @default(0)
  unsafeActionsPrevented Int          @default(0)
  snapshotJson        Json?
  recordedAt          DateTime        @default(now())

  @@unique([batchRunId, incidentId])
}

model RevenueIncident {
  id                 String                @id @default(uuid())
  sourcePaymentId    String                @unique
  status             RevenueIncidentStatus
  amountPaise        Int
  currency           String                @default("INR")
  customerRef        String
  paymentMethod      String
  failureCode        String
  failureDescription String
  consentToContact   Boolean               @default(false)
  attemptCount       Int                   @default(0)
  detectedAt         DateTime              @default(now())
  recoveredAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  events             RevenueEvent[]
  analyses           RevenueAnalysis[]
  policyDecisions    RevenuePolicyDecision[]
  actions            RevenueAction[]
  auditEvents        RevenueAuditEvent[]
  experimentResults  RevenueExperimentResult[]
}

model RevenueEvent {
  id              String          @id @default(uuid())
  externalEventId String          @unique
  incidentId      String
  incident        RevenueIncident @relation(fields: [incidentId], references: [id])
  eventType       String
  occurredAt      DateTime
  dataJson        Json
  createdAt       DateTime        @default(now())
}

model RevenueAnalysis {
  id             String          @id @default(uuid())
  incidentId     String
  incident       RevenueIncident @relation(fields: [incidentId], references: [id])
  modelRef       String
  promptVersion  String
  timelineDigest String
  outputJson     Json
  confidence     Float
  createdAt      DateTime        @default(now())
}

model RevenuePolicyDecision {
  id             String          @id @default(uuid())
  incidentId     String
  incident       RevenueIncident @relation(fields: [incidentId], references: [id])
  policyVersion  String
  proposedAction String
  finalAction    String
  authorized     Boolean
  reasonsJson    Json
  createdAt      DateTime        @default(now())
}

model RevenueAction {
  id                     String               @id @default(uuid())
  incidentId             String
  incident               RevenueIncident      @relation(fields: [incidentId], references: [id])
  actionType             String
  idempotencyKey         String               @unique
  outcome                RevenueActionOutcome @default(PENDING)
  scheduledFor           DateTime
  executedAt             DateTime?
  resultJson             Json?
  attributedRevenuePaise Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model RevenueAuditEvent {
  id            String          @id @default(uuid())
  incidentId    String
  incident      RevenueIncident @relation(fields: [incidentId], references: [id])
  eventType     String
  actorType     String
  actorId       String?
  policyVersion String?
  rationale     String
  dataJson      Json
  createdAt     DateTime        @default(now())
}

model RevenueExperiment {
  id                    String                    @id @default(uuid())
  name                  String
  cohortSize            Int
  totalValueAtRiskPaise Int
  policyVersion         String
  modelRef              String
  promptVersion         String
  cohortFingerprint     String
  baselineJson          Json
  metricsJson           Json
  startedAt             DateTime                  @default(now())
  completedAt           DateTime
  results               RevenueExperimentResult[]
}

model RevenueExperimentResult {
  id                     String            @id @default(uuid())
  experimentId           String
  experiment             RevenueExperiment @relation(fields: [experimentId], references: [id])
  incidentId             String
  incident               RevenueIncident   @relation(fields: [incidentId], references: [id])
  finalState             String
  recoveredValuePaise    Int               @default(0)
  interventionCount      Int               @default(0)
  unsafeActionsPrevented Int               @default(0)
  snapshotJson           Json
  recordedAt             DateTime          @default(now())

  @@unique([experimentId, incidentId])
}
